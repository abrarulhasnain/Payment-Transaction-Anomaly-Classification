# Python
.venv/
venv/
__pycache__/
*.pyc
.ipynb_checkpoints/
.env
.DS_Store
*.egg-info/

# Raw dataset — usually not committed due to size/license restrictions.
# Reviewers should place the CSV locally per data/README.md instead.
data/raw/*
data/raw/*.csv
!data/raw/.gitkeep

models/knn.joblib
models/decision_tree.joblib
# Processed data is regenerated by the pipeline — no need to commit it.
data/processed/*
!data/processed/.gitkeep

# NOTE on models/: the trained model (final_model.joblib) and preprocessing
# pipeline (preprocessing_pipeline.joblib) are INTENTIONALLY NOT ignored.
# The Streamlit app and the demo depend on these artifacts being present in
# the repository (or regenerated via `python -m src.train`) — for a
# capstone submission it is usually expected that the grader can run the
# app without re-training from scratch. If your submission guidelines
# instead require excluding large binaries, add the two lines below:
# models/*.joblib

# Reports are regenerated by the pipeline; figures/metrics can be large.
reports/figures/*
!reports/figures/.gitkeep
reports/metrics/*
!reports/metrics/.gitkeep
reports/error_analysis/*
!reports/error_analysis/.gitkeep

.venv/
__pycache__/
.ipynb_checkpoints/
data/raw/*.csv
models/knn.joblib
